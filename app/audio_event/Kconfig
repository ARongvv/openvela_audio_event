#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

config EXAMPLES_AUDIO_EVENT
	tristate "Audio event detection demo"
	default n
	depends on TFLITEMICRO && AUDIO && MATH_KISSFFT
	---help---
		Local audio event detection system:
		capture -> log-mel feature extraction -> TFLite inference -> alert.
		Supports knock and cough detection with background and silence
		rejection classes.

if EXAMPLES_AUDIO_EVENT

config EXAMPLES_AUDIO_EVENT_PROGNAME
	string "Program name"
	default "audio_event"
	---help---
		This is the name of the program that will be used when the NSH ELF
		program is installed.

config EXAMPLES_AUDIO_EVENT_PRIORITY
	int "Audio event demo task priority"
	default 100

config EXAMPLES_AUDIO_EVENT_STACKSIZE
	int "Audio event demo stack size"
	default 16384

config EXAMPLES_AUDIO_EVENT_DEVPATH
	string "Audio capture device path"
	default "/dev/audio/pcm0c"

config EXAMPLES_AUDIO_EVENT_INMP441_32BIT
	bool "Convert INMP441 32-bit I2S capture to mono PCM16"
	default n
	---help---
		Enable this when the capture device receives an INMP441 style
		32-bit I2S stream. The application configures the audio device
		as 16 kHz, two-channel, 32-bit PCM, selects one I2S slot, then
		converts it to the 16 kHz mono int16 samples expected by the
		model frontend.

config EXAMPLES_AUDIO_EVENT_INMP441_SLOT
	int "INMP441 slot index"
	default 0
	range 0 1
	depends on EXAMPLES_AUDIO_EVENT_INMP441_32BIT
	---help---
		Select the 32-bit I2S slot that contains microphone data.
		Use 0 for the left slot and 1 for the right slot.

config EXAMPLES_AUDIO_EVENT_INMP441_SHIFT
	int "INMP441 int32 to int16 right shift"
	default 16
	range 0 24
	depends on EXAMPLES_AUDIO_EVENT_INMP441_32BIT
	---help---
		Arithmetic right shift applied before saturating to int16.
		INMP441 commonly places 24-bit samples in the high bits of a
		32-bit slot, so 16 is a conservative starting point. Reduce
		this value only if the converted PCM16 level is too low.

config EXAMPLES_AUDIO_EVENT_ARENA_SIZE
	int "TFLite Micro tensor arena size"
	default 98304
	range 32768 262144

config EXAMPLES_AUDIO_EVENT_HOP_MS
	int "Inference window hop in milliseconds"
	default 250
	range 20 1000

choice EXAMPLES_AUDIO_EVENT_POWER_MODE

	prompt "Audio processing power mode"
	default EXAMPLES_AUDIO_EVENT_POWER_CONTINUOUS
	---help---
		Continuous keeps the existing feature extraction and model inference
		on every inference window. Energy gate keeps I2S capture running but
		skips DSP/TFLM on quiet windows after startup calibration.

config EXAMPLES_AUDIO_EVENT_POWER_CONTINUOUS
	bool "Continuous inference (P0 baseline)"

config EXAMPLES_AUDIO_EVENT_POWER_ENERGY_GATE
	bool "PCM energy gate (P1)"

endchoice

if EXAMPLES_AUDIO_EVENT_POWER_ENERGY_GATE

config EXAMPLES_AUDIO_EVENT_ENERGY_GATE_CALIBRATION_MS
	int "Startup noise-floor calibration time (ms)"
	default 2000
	range 500 10000

config EXAMPLES_AUDIO_EVENT_ENERGY_GATE_RMS_RATIO_PERMILLE
	int "RMS threshold/noise-floor ratio (permille)"
	default 2000
	range 1000 10000

config EXAMPLES_AUDIO_EVENT_ENERGY_GATE_RMS_OFFSET
	int "RMS threshold offset"
	default 200
	range 0 32767

config EXAMPLES_AUDIO_EVENT_ENERGY_GATE_RMS_MIN
	int "Minimum RMS activity threshold"
	default 600
	range 0 32767

config EXAMPLES_AUDIO_EVENT_ENERGY_GATE_RMS_MAX
	int "Maximum RMS activity threshold"
	default 6000
	range 1 32767

config EXAMPLES_AUDIO_EVENT_ENERGY_GATE_PEAK_RATIO_PERMILLE
	int "Peak threshold/RMS threshold ratio (permille)"
	default 2500
	range 1000 20000

config EXAMPLES_AUDIO_EVENT_ENERGY_GATE_PEAK_MIN
	int "Minimum peak activity threshold"
	default 1800
	range 0 32767

config EXAMPLES_AUDIO_EVENT_ENERGY_GATE_NOISE_ALPHA_PERMILLE
	int "Quiet-block noise-floor update rate (permille)"
	default 20
	range 1 1000

config EXAMPLES_AUDIO_EVENT_ENERGY_GATE_ACTIVE_HOLD_MS
	int "Active hold after last energetic block (ms)"
	default 1500
	range 0 10000

config EXAMPLES_AUDIO_EVENT_ENERGY_GATE_FORCE_PROBE_MS
	int "Quiet forced full-inference interval (ms, 0 disables)"
	default 5000
	range 0 60000

endif # EXAMPLES_AUDIO_EVENT_POWER_ENERGY_GATE

config EXAMPLES_AUDIO_EVENT_KNOCK_THRESHOLD
	int "Knock threshold in permille"
	default 750
	range 0 1000

config EXAMPLES_AUDIO_EVENT_COUGH_THRESHOLD
	int "Cough threshold in permille"
	default 750
	range 0 1000

config EXAMPLES_AUDIO_EVENT_CONSECUTIVE_HITS
	int "Consecutive windows required for an alert"
	default 2
	range 1 10

config EXAMPLES_AUDIO_EVENT_COOLDOWN_MS
	int "Alert cooldown in milliseconds"
	default 1500
	range 0 60000

config EXAMPLES_AUDIO_EVENT_OLED_UI
	bool "Enable compact 128x64 OLED status UI"
	default n
	depends on LCD_DEV
	---help---
		Enable a compact monochrome status UI for small 0.96 inch
		SSD1306-class OLED displays exposed as /dev/lcd0. This UI shows
		the current top class, confidence, RMS/volume, detection, and
		cooldown status. It is intended for ESP32-S3 DevKit style boards.

if EXAMPLES_AUDIO_EVENT_OLED_UI

config EXAMPLES_AUDIO_EVENT_OLED_DEVPATH
	string "OLED LCD device path"
	default "/dev/lcd0"

endif # EXAMPLES_AUDIO_EVENT_OLED_UI

config EXAMPLES_AUDIO_EVENT_UI
	bool "Enable LVGL dashboard UI"
	default n
	depends on GRAPHICS_LVGL
	---help---
		Enable a real-time LVGL dashboard showing audio waveform,
		classification probabilities, and detection alerts on
		LCD display.

if EXAMPLES_AUDIO_EVENT_UI

config EXAMPLES_AUDIO_EVENT_UI_DEVPATH
	string "LCD display device path"
	default "/dev/lcd0"
	---help---
		Path to the LCD display device for LVGL rendering.

endif # EXAMPLES_AUDIO_EVENT_UI

endif
