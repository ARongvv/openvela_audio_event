#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

config EXAMPLES_AUDIO_TEST
	tristate "Audio capture diagnostic tool"
	default n
	depends on AUDIO
	---help---
		Lightweight PCM capture diagnostic command. It opens an audio input
		device, captures PCM, and prints amplitude stats.

if EXAMPLES_AUDIO_TEST

config EXAMPLES_AUDIO_TEST_PROGNAME
	string "Program name"
	default "audio_test"
	---help---
		This is the name of the program that will be used when the NSH ELF
		program is installed.

config EXAMPLES_AUDIO_TEST_PRIORITY
	int "Audio test task priority"
	default 100

config EXAMPLES_AUDIO_TEST_STACKSIZE
	int "Audio test stack size"
	default 8192

config EXAMPLES_AUDIO_TEST_DEVPATH
	string "Audio capture device path"
	default "/dev/audio/pcm_in1"

config EXAMPLES_AUDIO_TEST_SAMPLE_RATE
	int "Audio sample rate"
	default 16000
	range 8000 48000

config EXAMPLES_AUDIO_TEST_CHANNELS
	int "Audio channel count"
	default 1
	range 1 2

config EXAMPLES_AUDIO_TEST_INMP441_32BIT
	bool "Decode INMP441 32-bit I2S capture"
	default y if ESP32S3_DEVKIT_INMP441
	---help---
		Configure the device as 2-channel 32-bit PCM and decode the selected
		INMP441 slot to mono int16. The diagnostic output also prints both
		decoded slots so slot alignment and gain/shift issues are visible.

config EXAMPLES_AUDIO_TEST_INMP441_SLOT
	int "INMP441 slot index"
	default 0
	range 0 1
	depends on EXAMPLES_AUDIO_TEST_INMP441_32BIT

config EXAMPLES_AUDIO_TEST_INMP441_SHIFT
	int "INMP441 int32 to int16 right shift"
	default 16
	range 0 24
	depends on EXAMPLES_AUDIO_TEST_INMP441_32BIT

config EXAMPLES_AUDIO_TEST_BLOCK_FRAMES
	int "Frames per capture read"
	default 512
	range 1 1024

endif
