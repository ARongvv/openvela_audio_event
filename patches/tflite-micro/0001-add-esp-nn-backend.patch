+ESP_NN_ASRCS := $(wildcard $(ESP_NN_DIR)/src/*/*_esp32s3.S)
+UNNEEDED_SRCS := $(TFLM_DIR)/tensorflow/lite/micro/kernels/conv.cc
+UNNEEDED_SRCS += $(TFLM_DIR)/tensorflow/lite/micro/kernels/depthwise_conv.cc
+CXXSRCS := $(filter-out $(UNNEEDED_SRCS), $(CXXSRCS))
+CXXSRCS += kernels/esp_nn/conv.cc
+CXXSRCS += kernels/esp_nn/depthwise_conv.cc
+CXXSRCS += kernels/esp_nn/mean.cc
+CSRCS += $(ESP_NN_CSRCS)
+ASRCS += $(ESP_NN_ASRCS)
+CFLAGS += -O2 -fno-unroll-loops
