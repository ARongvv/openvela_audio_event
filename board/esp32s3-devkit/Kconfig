#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

if ARCH_BOARD_CUSTOM

choice
	prompt "ESP32-S3-DevKitC-1 version"
	default CCF_ESP32S3_DEVKITC_1_V10

config CCF_ESP32S3_DEVKITC_1_V10
	bool "ESP32-S3-DevKitC-1 v1.0"

config CCF_ESP32S3_DEVKITC_1_V11
	bool "ESP32-S3-DevKitC-1 v1.1"
endchoice

config ESP32S3_DEVKIT_INMP441
	bool "Enable INMP441 I2S microphone"
	default n
	select ESP32S3_I2S
	select ESP32S3_I2S1
	select ESP32S3_I2S1_RX
	select AUDIO
	select AUDIO_I2S
	select AUDIO_I2SCHAR
	select DRIVERS_AUDIO
	---help---
		Register ESP32-S3 I2S1 RX as an audio capture device for an
		external INMP441 digital microphone. This board option only wires
		the I2S audio path; INMP441 has no I2C codec initialization.

config ESP32S3_DEVKIT_OLED
	bool "Enable 0.96 inch SSD1306 I2C OLED"
	default n
	select ESP32S3_I2C
	select ESP32S3_I2C0
	select LCD
	select LCD_DEV
	---help---
		Register a 0.96 inch 128x64 SSD1306-compatible OLED on I2C0.
		The audio_event board configuration uses GPIO4 as SDA, GPIO5 as
		SCL, and the typical 7-bit I2C address 0x3c.

endif # ARCH_BOARD_CUSTOM
